[Unit]
Description=Tabletop Robot Orchestrator (Sonku)
After=network.target ollama.service
Wants=ollama.service

[Service]
Type=simple
User=dhirajpatra
WorkingDirectory=/home/dhirajpatra/sonku
EnvironmentFile=/home/dhirajpatra/sonku/.env
ExecStart=/home/dhirajpatra/robot_env/bin/python3 /home/dhirajpatra/sonku/robot_main.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target