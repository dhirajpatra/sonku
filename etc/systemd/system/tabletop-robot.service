[Unit]
Description=Tabletop Robot Orchestrator (Sonku)
After=network.target ollama.service
Wants=ollama.service

[Service]
Type=simple
User=dhirajpatra
WorkingDirectory=/home/dhirajpatra/
EnvironmentFile=/home/dhirajpatra/.env
Environment="VIRTUAL_ENV=/home/dhirajpatra/robot_env"
Environment="PATH=/home/dhirajpatra/robot_env/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Environment="PYTHONUNBUFFERED=1"
ExecStart=/home/dhirajpatra/robot_env/bin/python3 /home/dhirajpatra/robot_main.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target