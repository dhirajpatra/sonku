# ==============================================================================
# LLM Backend Selection & Routing
# ==============================================================================
# Options: "meta_api" or "ollama"
# When set to "meta_api", automatically falls back to "ollama" if API times out or fails.
LLM_BACKEND=meta_api

# ==============================================================================
# Primary Backend: Meta REST API (Muse Spark 1.3 Contributor)
# ==============================================================================
MODEL_API_KEY=your_meta_api_key_here
META_API_URL=https://api.meta.ai/v1/responses
META_MODEL=muse-spark-1.3-contributor

# ==============================================================================
# Local Fallback Backend: Ollama (Qwen 3.5 4B)
# ==============================================================================
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=qwen3.5:4b

# ==============================================================================
# Indian Language TTS (Oomni / Mithi-v1-flash)
# ==============================================================================
MITHI_MODEL_PATH=/home/dhirajpatra/mithi-v1-flash
# Voice options: "charvi" (female) or "satvik" (male)
DEFAULT_VOICE=charvi

# ==============================================================================
# Camera & Hardware Settings
# ==============================================================================
FRAME_CAPTURE_PATH=/tmp/current_frame.jpg
CAMERA_WIDTH=640
CAMERA_HEIGHT=480

# Ollama Model Configurations
SLM_MODEL=qwen3.5:4b

# System Paths & Database
DB_PATH=/home/dhirajpatra/sonku_memory.db
TEMP_FRAME_PATH=/tmp/current_frame.jpg
TEMP_AUDIO_IN=/tmp/input.wav
TEMP_AUDIO_OUT=/tmp/speech.wav

# Thresholds & Timers
CHECK_INTERVAL_SEC=120
COMPRESSION_THRESHOLD_MB=50

# Voice Engine Settings
WHISPER_MODEL=tiny.en
PIPER_MODEL=en_US-lessac-medium

FALLBACK_TIMEOUT=30
MAX_OUTPUT_TOKENS=500
MAX_MEMORY_GB=5.0

# raspi admin
USERNAME=
PASSWORD=