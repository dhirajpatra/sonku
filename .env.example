# =============================================================================
# Sonku configuration. Copy to .env and edit:  cp .env.example .env
# Values marked (live) can also be changed from the admin panel without restart.
# =============================================================================

# --- Admin web panel ---------------------------------------------------------
WEB_HOST=0.0.0.0
WEB_PORT=8000
ADMIN_USER=admin
# REQUIRED. If empty, a random password is generated at every start and printed to the log.
ADMIN_PASSWORD=

# --- LLM routing -------------------------------------------------------------
# meta_api = try Meta API first, fall back to local Ollama on error/timeout. ollama = local only. (live)
LLM_BACKEND=meta_api
MODEL_API_KEY=your_meta_api_key_here
META_API_URL=https://api.meta.ai/v1/responses
# muse-spark-1.3-contributor = same model as muse-spark-1.3 at a deep discount, BUT Meta may train on your prompts,
#   replies and camera frames. Use muse-spark-1.3 (standard tier) if you do not want that.
# muse-wonder-1.0 = Meta's frontier model, about 40x the price; its default reasoning effort is "max".
META_MODEL=muse-spark-1.3-contributor
# Send instructions as a developer message and the photo as an input_image block (Meta's recommended layout).
# Falls back to one plain text prompt by itself if Meta rejects it.
META_STRUCTURED_INPUT=true
# Seconds to wait for Meta before falling back to Ollama (live). Keep low for a voice robot.
FALLBACK_TIMEOUT=25
# Meta's reasoning step counts against this; too low gives an empty answer
MAX_OUTPUT_TOKENS=1500
# minimal | low | medium | high | xhigh (Muse reasoning is always on; hidden reasoning tokens are billed as output).
# Compare speed and tokens with `python scripts/diagnose.py meta-tokens`.
META_REASONING_EFFORT=low

# --- Local LLM (Ollama) ------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:2b-q4_K_M
# Small model for quick decisions (needs camera? extract a name?). SKILL.md says "tev1:0.8b":
# confirm the exact Ollama tag with `ollama list`.
DECISION_MODEL=qwen3.5:0.8b
DECISION_USE_LLM=true
OLLAMA_KEEP_ALIVE=30m
OLLAMA_NUM_CTX=2048
OLLAMA_NUM_PREDICT=400
# Send camera frames to the local model too (needs a vision-capable tag)
OLLAMA_VISION=true
HISTORY_TURNS=6

# --- Speech to text ----------------------------------------------------------
# Comma-separated, tried in order: google | whisper_cpp | indic
STT_BACKEND=google
GOOGLE_STT_LANG=en-IN
WHISPER_CPP_BIN=whisper-cli
WHISPER_CPP_MODEL=
# Needs `pip install -r requirements-indic.txt` and `hf auth login` (gated model)
INDIC_STT_MODEL=bodhan-ai/indic-transcribe-core

# --- Text to speech / audio devices -----------------------------------------
MITHI_MODEL_PATH=/home/dhirajpatra/mithi-v1-flash
# charvi (female) | satvik (male) (live)
DEFAULT_VOICE=charvi
# Online English-only fallback if Mithi fails to load
TTS_FALLBACK_GTTS=true
# auto = use the sound server (PipeWire/Pulse) when it is running, so Bluetooth, USB (Jabra) and built-in
# devices all work and are detected automatically. alsa = talk to ALSA hardware directly.
AUDIO_BACKEND=auto
# Which kind of device wins when several are connected (first is preferred). (live)
AUDIO_PRIORITY=bluetooth,usb,other
# Only used when AUDIO_BACKEND=alsa or no sound server is running (see `aplay -l`, `diagnose.py devices`)
AUDIO_INPUT_MATCH=Jabra
AUDIO_OUTPUT_DEVICE=plughw:2,0
VAD_MIN_RMS=350
VAD_SILENCE_SEC=0.9
MAX_UTTERANCE_SEC=30
# After a sentence that sounds unfinished ("... and", "wait, let me think") Sonku waits this long for the rest
PATIENCE_SEC=8

# --- Camera and faces --------------------------------------------------------
# auto | picamera2 | rpicam | opencv
CAMERA_BACKEND=auto
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
CAMERA_ROTATE_180=true
# Frames sent to the model for "what do you see?" are shrunk to this longest side (pixels) to save time and tokens
VISION_MAX_SIDE=1024
PRESENCE_INTERVAL_SEC=0.7
ABSENCE_SEC=8
FACE_MIN_WIDTH_PX=70
FACE_MATCH_THRESHOLD=0.363
# Overwrite the oldest stored face template once it is this old (live)
FACE_REFRESH_DAYS=30
# Delete face templates not refreshed for this long; 0 = never (live)
FACE_MAX_AGE_DAYS=90
# Extra looks (angle, light) are learned automatically up to this many per person
FACES_PER_PERSON=6
MODELS_DIR=models

# --- Behaviour ---------------------------------------------------------------
WAKE_WORDS=sonku
GREETING_ENABLED=true
GREET_COOLDOWN_MIN=10
# Seconds of silence before a conversation closes
SESSION_TIMEOUT_SEC=120
# A known person must be out of camera view this long before their conversation closes
SESSION_ABSENT_SEC=45
# Ask "may I remember your face?" before enrolling (recommended)
REQUIRE_FACE_CONSENT=true

# --- Memory ------------------------------------------------------------------
DATA_DIR=data
# Whole data directory (database + logs). Warning at 80%, oldest conversations pruned at 100%. (live)
MAX_MEMORY_GB=5.0
COMPRESSION_THRESHOLD_MB=50
CHECK_INTERVAL_SEC=600
SUMMARY_KEEP_RECENT=10
# Write a fresh summary of a person's older chats after this many new turns (uses Meta, falls back to Ollama)
SUMMARY_EVERY_TURNS=20
# Earlier turns reloaded when a known person starts talking again
RESUME_TURNS=6
# People kept hot in memory (their face templates, compact notes and last turns). Minimum 3.
PERSON_CACHE_SIZE=5

# --- Development -------------------------------------------------------------
# true = no camera/mic/speaker, only the web panel and LLM (for laptop development)
SONKU_HEADLESS=false
LOG_LEVEL=INFO
